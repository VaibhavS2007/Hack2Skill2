# Environment Configuration for SpendSwipe
# When deploying to Google Cloud Run, set these via Google Cloud Console or Secret Manager.

PORT=8080
NODE_ENV=production

# Client-Side Security Flags
VITE_ENABLE_DEBUG_LOGS=false
VITE_ENABLE_ANALYTICS=false

# Optional: Groq API Key for AI Financial Review & Roast (llama-3.3-70b-versatile)
# If left empty, SpendInvaders automatically uses its built-in intelligent offline advisor engine.
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
